--- FUNC make_color ---
RawLine("SET Z 2;")
RawLine("SET V Y;")
RawLine("ADD V Z;")
RawLine("LOAD W V;")
Set("v0", "W")
Set("v1", "g25")
Add("v1", "v0")
Set("Z", "v1")
Ret
Ret

--- FUNC gui_clear ---
Push("g2")
Call("make_color")
RawLine("GETSP W;")
RawLine("SET Z 1;")
RawLine("ADD W Z;")
RawLine("SETSP W;")
Set("v3", "Z")
Set("v2", "v3")
LoadPhys("A", "v2")
RawLine("CLEARSCREEN A;")
Ret

